# Non-secret production environment values for grimoire.
# Secrets (database credentials, S3 key pair, VAPID key pair) are delivered by the platform secret store, never this file.
GRIMOIRE_ADDR=:8080
GRIMOIRE_AUTO_MIGRATE=true
GRIMOIRE_RATE_LIMIT_PER_MINUTE=600
GRIMOIRE_AUTO_IMPORT=true
GRIMOIRE_OAUTH_ISSUER=https://auth.jorisjonkers.dev
GRIMOIRE_S3_REGION=garage
GRIMOIRE_S3_BUCKET=grimoire-assets
GRIMOIRE_VAPID_CONTACT=security@jorisjonkers.dev

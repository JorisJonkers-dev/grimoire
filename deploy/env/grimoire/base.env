# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
GRIMOIRE_ADDR=:8080
GRIMOIRE_AUTO_MIGRATE=true
GRIMOIRE_AUTO_IMPORT=true
GRIMOIRE_RATE_LIMIT_PER_MINUTE=600

# The database: the URL names only the database, and pgx takes the host, the port and
# the login the edge derives from the libpq variables.
GRIMOIRE_DATABASE_URL=postgres:///grimoire_db?sslmode=disable
PGHOST=${dependency:platform-postgres.host}
PGPORT=${dependency:platform-postgres.port}
PGUSER=${dependency:platform-postgres.username}
PGPASSWORD=${dependency:platform-postgres.password}

# Where grimoire is reached: the links it emails and its OIDC callback, <base>/oidc/callback.
GRIMOIRE_BASE_URL=${exposure:grimoire.public#url}
GRIMOIRE_OAUTH_ISSUER=${exposure:auth.public#url}
GRIMOIRE_OIDC_ISSUER=${exposure:auth.public#url}
GRIMOIRE_OIDC_CLIENT_ID=grimoire
GRIMOIRE_OIDC_NAME=jorisjonkers.dev
GRIMOIRE_OIDC_CLIENT_SECRET=${secret:secret/data/platform/grimoire#oidc.client_secret}

# Garage, path-style. A literal until a Project declares Garage.
GRIMOIRE_S3_ENDPOINT=http://garage.data-system.svc.cluster.local:3900
GRIMOIRE_S3_REGION=garage
GRIMOIRE_S3_BUCKET=grimoire-assets
GRIMOIRE_S3_ACCESS_KEY_ID=${secret:secret/data/platform/grimoire#s3.access_key_id}
GRIMOIRE_S3_SECRET_ACCESS_KEY=${secret:secret/data/platform/grimoire#s3.secret_access_key}

GRIMOIRE_VAPID_CONTACT=security@jorisjonkers.dev
GRIMOIRE_VAPID_PUBLIC_KEY=${secret:secret/data/platform/grimoire#vapid.public_key}
GRIMOIRE_VAPID_PRIVATE_KEY=${secret:secret/data/platform/grimoire#vapid.private_key}

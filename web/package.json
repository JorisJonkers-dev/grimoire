    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",

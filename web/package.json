{
  "name": "@grimoire/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vue-tsc --noEmit -p src/sw && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "gen": "openapi-ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",

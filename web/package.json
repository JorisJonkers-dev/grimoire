    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@tanstack/vue-query": "5.105.3",
    "pinia": "4.1.0",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.6.0",
    "@hey-api/openapi-ts": "0.99.0",
